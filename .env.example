# 静的サイトの本番HTTPSルートURL（実際の取得済みドメインを指定）
# 自動読込はしません。シェルまたはCloudflareで環境変数として設定します。
SITE_URL=

# Cloudflare Pagesの本番ブランチ名（実際の設定に合わせる）
PRODUCTION_BRANCH=

# 以下は旧Google News→Notion処理専用。新サイトでは不要です。
NOTION_API_KEY=
NOTION_DATABASE_ID=

# 本番公開用：実際の運営者名と問い合わせフォーム等のHTTPS URL
PUBLIC_OPERATOR=
PUBLIC_CONTACT_URL=

# 作成済みのCloudflare Pagesプロジェクト名
CLOUDFLARE_PAGES_PROJECT=
